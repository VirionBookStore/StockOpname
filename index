<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live Barcode Scanner</title>
    <!-- Tailwind CSS untuk styling cepat -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Library HTML5 QR Code & Barcode Scanner -->
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
</head>
<body class="bg-gray-100 p-4 font-sans">

    <div class="max-w-md mx-auto bg-white rounded-lg shadow-md p-6">
        <h1 class="text-xl font-bold text-center mb-4">Scanner Barcode / QR</h1>
        
        <!-- Tempat kamera akan dirender -->
        <div id="reader" class="w-full mb-4"></div>

        <!-- Notifikasi Hasil -->
        <div id="status" class="hidden p-3 mb-4 text-sm rounded-lg" role="alert"></div>

        <div class="mt-4 text-center">
            <p class="text-sm text-gray-600">Arahkan kamera ke barcode buku atau QR code.</p>
        </div>
    </div>

    <script>
        // GANTI DENGAN URL WEB APP GOOGLE APPS SCRIPT ANDA
        const GAS_URL = "https://script.google.com/macros/s/AKfycbz-iY-96QdoRzYWZL5cZsAPSlbXKXgmThpGY3Ge0veo4sfzFpw5CnU4uBMNIvgpQT6R-w/exec"; 

        // Fungsi yang dijalankan ketika barcode berhasil di-scan
        function onScanSuccess(decodedText, decodedResult) {
            // Hentikan scanner sementara saat memproses data
            html5QrcodeScanner.pause();
            
            showStatus("Memproses barcode: " + decodedText + "...", "bg-blue-100 text-blue-700");

            // Kirim data ke Google Apps Script
            fetch(GAS_URL, {
                method: 'POST',
                mode: 'no-cors', // Penting untuk menghindari error CORS dari GAS
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    action: 'scan',
                    barcode: decodedText
                })
            })
            .then(response => {
                showStatus("Berhasil menyimpan barcode: " + decodedText, "bg-green-100 text-green-700");
                // Lanjutkan scan setelah 2 detik
                setTimeout(() => {
                    hideStatus();
                    html5QrcodeScanner.resume();
                }, 2000);
            })
            .catch(error => {
                showStatus("Gagal mengirim data: " + error, "bg-red-100 text-red-700");
                setTimeout(() => {
                    hideStatus();
                    html5QrcodeScanner.resume();
                }, 3000);
            });
        }

        function onScanFailure(error) {
            // Abaikan error saat proses mencari frame barcode
        }

        // Konfigurasi Scanner
        let html5QrcodeScanner = new Html5QrcodeScanner(
            "reader", 
            { 
                fps: 10, 
                qrbox: {width: 250, height: 150},
                supportedScanTypes: [Html5QrcodeScanType.SCAN_TYPE_CAMERA]
            }, 
            /* verbose= */ false
        );
        
        // Mulai Scanner
        html5QrcodeScanner.render(onScanSuccess, onScanFailure);

        // Fungsi bantuan untuk menampilkan notifikasi UI
        function showStatus(message, classes) {
            const statusDiv = document.getElementById('status');
            statusDiv.className = `p-3 mb-4 text-sm rounded-lg ${classes} block`;
            statusDiv.innerText = message;
        }

        function hideStatus() {
            document.getElementById('status').classList.add('hidden');
        }
    </script>
</body>
</html>
